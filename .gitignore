# ─── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build output ─────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Testing ──────────────────────────────────────────────────────────────────
/coverage

# ─── Environment files ────────────────────────────────────────────────────────
# Real environment values must NEVER be committed.
# Copy .env.example → .env.local and fill in your values.
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
# Catch-all pattern for any other .env variants:
.env*

# ─── TypeScript / Next.js generated ──────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig

# ─── Debug / Logs ─────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ─── Turbo ────────────────────────────────────────────────────────────────────
.turbo

# ─── Cache ────────────────────────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache

# ─── Credentials / Certificates (never commit these) ─────────────────────────
*.pem
*.key
*.p12
*.pfx
*.cer
*-service-account.json
service-account.json

# ─── Database dumps (never commit) ───────────────────────────────────────────
*.sql
*.dump
*.sqlite
*.db

# ─── Temporary / backup files ────────────────────────────────────────────────
*.bak
*.tmp
*~
